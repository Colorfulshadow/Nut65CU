+    if (raw_from_module) {
+        md_send_raw(data, length);
+    } else if (get_transport() == TRANSPORT_USB || USB_DRIVER.state == USB_ACTIVE) {
         send_report(USB_ENDPOINT_IN_RAW, data, length);
