+
+// Counters of what the module sent us, for checking the raw HID path (Bluetooth).
+typedef struct {
+    uint16_t frames;     // frames with a good checksum
+    uint16_t bad_sum;    // complete frames with a bad checksum
+    uint16_t unknown;    // bytes that didn't start a known frame
+    uint16_t raw_rx;     // raw packets passed on
+    uint16_t raw_tx;     // raw packets sent
+    uint8_t  unknown_last;
+    uint8_t  raw_len;    // length byte of the last raw packet
+    uint8_t  last[4][2]; // command, first byte of the last frames other than battery level
+    uint16_t tx_retries; // protocol 7: UART retries, wraps at 65536
+    uint16_t tx_dropped; // packets dropped after the retry budget
+    uint16_t queue_full; // enqueue rejected; not a radio loss counter
+} md_diag_t;
+extern md_diag_t md_diag;
